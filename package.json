{
  "name": "dsh-codex-style-computer-use",
  "version": "2.3.5",
  "description": "Windows desktop automation for DeepSeek Harness. Discover actions per control, scroll to an exact percentage, switch views, and place the caret before or after matching text. Includes OCR and a prebuilt Windows worker.",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-codex-style-computer-use": "mcp/src/index.js",
    "dsh-computer-use-mcp": "mcp/src/index.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": "./client.js"
  },
  "files": [
    "icon.svg",
    "lib",
    "mcp",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "scripts",
    "client.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0 || >=0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0 || >=0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.0.0",
    "@deepseek-ai/dsh-scope": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0 || >=0.2.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-scope": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "os": [
    "win32"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ltmroberthk915/dsh-computer-use.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "computer-use",
    "windows",
    "gui-automation",
    "set-of-marks",
    "uia",
    "mcp",
    "codex-style",
    "desktop-automation",
    "dsh-market"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "node scripts/check-behavior.mjs",
    "build:native": "node scripts/build-native.mjs",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "homepage": "https://github.com/ltmroberthk915/dsh-computer-use#readme",
  "bugs": {
    "url": "https://github.com/ltmroberthk915/dsh-computer-use/issues"
  },
  "icon": "./icon.svg"
}
